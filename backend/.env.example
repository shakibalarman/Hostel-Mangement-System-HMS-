# -----------------------------------------------------------------------------
# Hostel Management System - environment configuration (DEVELOPMENT VALUES)
# Copy this file to .env and adjust the values. Never commit .env to Git.
# -----------------------------------------------------------------------------

APP_NAME="Hostel Management System"
DEBUG=True

# PostgreSQL connection (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://shakibalarman:shakibalarman@localhost:5432/hms

# Security - generate a strong random key for production (e.g. openssl rand -hex 64)
SECRET_KEY=change-me-generate-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
